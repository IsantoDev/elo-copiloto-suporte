# ---------------------------------------------------------------------------
# Copie para .env e preencha. O .env fica fora do Git.
# ---------------------------------------------------------------------------

# Movidesk ------------------------------------------------------------------
MOVIDESK_TOKEN=seu_token_aqui
MOVIDESK_URL=https://suaempresa.movidesk.com

# PostgreSQL (precisa da extensão pgvector) ---------------------------------
PGHOST=seu_host.exemplo.com
PGPORT=25060
PGDATABASE=nome_do_banco
PGUSER=seu_usuario
PGPASSWORD=sua_senha
PGSSLMODE=require

# LLM local (Ollama): nenhum texto de ticket sai da máquina ------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:7b
# quanto tempo o modelo fica na memória depois do último pedido
# (notebook: 5m devolve a RAM; servidor: 60m)
OLLAMA_KEEP_ALIVE=60m
# 1 = gera em segundo plano os rascunhos da fila aberta
PREGERAR=1

# Servidor ------------------------------------------------------------------
# 127.0.0.1 no Windows; no container, 0.0.0.0 (a porta só sai pelo compose)
ELO_HOST=127.0.0.1
ELO_PORTA=8000
# pasta da base de conhecimento (documentos, urls.txt, espacos.txt)
PASTA_DOCS=base_conhecimento
# hora da sincronização diária da base de conhecimento, dentro do container
AGENDA_DOCUMENTOS=07:30

# Chave das senhas da tela Acessos ------------------------------------------
# Criada sozinha na primeira execução e gravada aqui. Sem ela, as senhas já
# guardadas não podem ser lidas: mantenha uma cópia em lugar seguro.
ELO_CHAVE_ACESSOS=

# Modelo de embeddings (opcional; só é preciso para modelos privados) --------
HF_TOKEN=

# Planner (Microsoft Graph), opcional ---------------------------------------
# App registrado no Entra da empresa; login delegado, só leitura de tarefas.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
PLANNER_PLANOS=
# pastas extras com o planner.json exportado, separadas por ponto e vírgula
PLANNER_PASTAS=
